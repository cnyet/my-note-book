# 数据库配置
# 异步驱动: aiosqlite (必须使用 sqlite+aiosqlite:// 前缀)
DATABASE_URL=sqlite+aiosqlite:///./data/my_note_book.db

# JWT 认证配置
# IMPORTANT: 生产环境请生成安全密钥: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_GENERATE_SECURE_KEY_WITH_PYTHON_SECRETS_MODULE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 环境配置
ENVIRONMENT=development

# CORS 配置
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# 应用配置
APP_ENV=development
APP_NAME=MyNoteBook
APP_VERSION=0.1.0
DEBUG=true

# 日志配置
LOG_LEVEL=INFO

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB

# Redis 配置（可选）
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=

# 管理员初始账户配置（仅首次初始化时使用）
# WARNING: 默认管理员密码应在生产环境中立即修改
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=CHANGE_THIS_IMMEDIATELY
FIRST_ADMIN_EMAIL=admin@example.com

# AI 服务配置
# Nano Banana Pro - 图片生成服务
NANO_BANANA_API_KEY=your_nanobanana_api_key_here
NANO_BANANA_BASE_URL=https://api.nanobanana.pro/v1

# Anthropic API - LLM 服务（任务规划、四象限分析、饮食健身计划生成）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 营养 API - Spoonacular（营养成分计算）
SPOONACULAR_API_KEY=your_spoonacular_api_key_here
SPOONACULAR_BASE_URL=https://api.spoonacular.com

# 健身 API - Exercise DB（健身动作教程）
EXERCISE_DB_API_KEY=your_exercise_db_api_key_here
EXERCISE_DB_BASE_URL=https://exercisedb.p.rapidapi.com
